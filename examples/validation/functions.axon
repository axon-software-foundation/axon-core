# No LLM, Python, shell commands or input files are required.
import "math.axon"

main {
    if add(20, 22) != 42 { raise "add failed" }
    if factorial(6) != 720 { raise "recursion failed" }
    triple = multiplier(3)
    by_ten = multiplier(10)
    if triple(5) != 15 { raise "closure failed" }
    if by_ten(7) != 70 { raise "independent closure failed" }
    square = (n) => n * n
    if square(7) != 49 { raise "arrow failed" }
    if multiplier(4)(6) != 24 { raise "chained function call failed" }
    print("factorial(6):", factorial(6))
    print("triple(5):", triple(5))
    print("square(7):", square(7))
    print("PASS functions")
}
