# Requires external Python; every invocation uses an independent process.
flow Demo { debug=false timeout=15 }
func python_work(n, context) {
    python [value=n, text=context] {
        assert "\n" in text
        return value * 2
    }
    return __result__
}
main {
    context="first\nsecond"
    parallel { left=python_work(10,context) right=python_work(20,context) }
    if left != 20 { raise "left Python result was lost" }
    if right != 40 { raise "right Python result was lost" }
    print("PASS Python interop in parallel branches")
}
