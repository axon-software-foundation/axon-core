cmake_minimum_required(VERSION 3.20)
foreach(required AXON_EXE SOURCE_ROOT WORK_ROOT)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
file(MAKE_DIRECTORY "${WORK_ROOT}")
foreach(name readonly_assignment readonly_index readonly_attribute reserved_parameter duplicate_input flow_location agent_location task_location agent_main_location)
    if(name MATCHES "^(readonly|reserved)")
        set(expected "reserved and read-only")
    elseif(name STREQUAL "duplicate_input")
        set(expected "duplicate input")
    elseif(name STREQUAL "agent_main_location")
        set(expected "allowed only")
    else()
        set(expected "not allowed directly")
    endif()
    execute_process(COMMAND "${AXON_EXE}" check "${SOURCE_ROOT}/examples/validation/python_errors/${name}.axon"
        WORKING_DIRECTORY "${WORK_ROOT}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
    string(FIND "${output}${error}" "${expected}" diagnostic)
    if(NOT "${status}" STREQUAL "1" OR diagnostic LESS 0)
        message(FATAL_ERROR "${name}: expected exit 1 and ${expected}; got ${status}\n${output}\n${error}")
    endif()
endforeach()
message(STATUS "PASS: nine Python syntax/readonly fixtures")
