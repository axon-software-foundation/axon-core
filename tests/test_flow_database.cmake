cmake_minimum_required(VERSION 3.20)
foreach(required AXON_EXE TEST_CASE VALIDATION_DIR WORK_ROOT)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
set(fixture "${VALIDATION_DIR}/flow_database_errors/${TEST_CASE}.axon")
set(work "${WORK_ROOT}/${TEST_CASE} space")
file(MAKE_DIRECTORY "${work}")
set(syntax_cases duplicate_declaration duplicate_alias duplicate_option missing_assignment)
set(expected_check 0)
if(TEST_CASE IN_LIST syntax_cases)
    set(expected_check 1)
endif()
execute_process(COMMAND "${AXON_EXE}" check "${fixture}"
    WORKING_DIRECTORY "${work}" RESULT_VARIABLE result
    OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
if(NOT "${result}" STREQUAL "${expected_check}")
    message(FATAL_ERROR "${TEST_CASE}: check exit ${result}, expected ${expected_check}\n${out}\n${err}")
endif()
execute_process(COMMAND "${AXON_EXE}" run "${fixture}"
    WORKING_DIRECTORY "${work}" RESULT_VARIABLE result
    OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
set(output "${out}\n${err}")
if(NOT "${result}" STREQUAL "1" OR NOT output MATCHES "FlowDatabaseError:")
    message(FATAL_ERROR "${TEST_CASE}: expected controlled FlowDatabaseError and exit 1\n${output}")
endif()
if(TEST_CASE STREQUAL "registry_type")
    set(expected "must be a dictionary of alias -> configuration")
elseif(TEST_CASE STREQUAL "alias_type" OR TEST_CASE STREQUAL "legacy_flat_config")
    set(expected "must be a configuration dictionary")
elseif(TEST_CASE STREQUAL "empty_alias")
    set(expected "aliases must be non-empty")
elseif(TEST_CASE STREQUAL "missing_driver" OR TEST_CASE STREQUAL "missing_database")
    set(expected "requires explicit driver and database")
elseif(TEST_CASE STREQUAL "option_type")
    set(expected "readonly must be bool")
elseif(TEST_CASE STREQUAL "unsupported_driver")
    set(expected "supported driver: sqlite")
elseif(TEST_CASE STREQUAL "duplicate_declaration")
    set(expected "duplicate database declaration")
elseif(TEST_CASE STREQUAL "duplicate_alias")
    set(expected "duplicate database alias 'primary'")
elseif(TEST_CASE STREQUAL "duplicate_option")
    set(expected "duplicate configuration key 'database'")
elseif(TEST_CASE STREQUAL "missing_assignment")
    set(expected "database requires '='")
else()
    message(FATAL_ERROR "Unknown flow database case ${TEST_CASE}")
endif()
string(FIND "${output}" "${expected}" found)
if(found LESS 0)
    message(FATAL_ERROR "${TEST_CASE}: expected diagnostic ${expected}\n${output}")
endif()
if(output MATCHES "SHOULD_NOT_RUN")
    message(FATAL_ERROR "${TEST_CASE}: main ran despite an invalid declaration\n${output}")
endif()
