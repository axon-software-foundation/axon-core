# Black-box CLI regression tests. Each case has its own cwd, including spaces.
foreach(required AXON_EXE EXIT_EXE TEST_CASE WORK_ROOT VALIDATION_DIR)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
set(work "${WORK_ROOT}/${TEST_CASE} space")
file(REMOVE_RECURSE "${work}")
file(MAKE_DIRECTORY "${work}")
get_filename_component(suffix "${AXON_EXE}" EXT)
if(NOT WIN32)
    set(suffix "")
endif()
get_filename_component(bin_dir "${AXON_EXE}" DIRECTORY)
set(command "${AXON_EXE}")
set(args run "${work}/main.axon")
set(expected_code 0)
set(expected_text "PASS")

if(TEST_CASE MATCHES "^(suites|missing_suite|failing_suite)$")
    file(COPY "${AXON_EXE}" DESTINATION "${work}")
    get_filename_component(cli_name "${AXON_EXE}" NAME)
    set(command "${work}/${cli_name}")
    set(args test)
    if(TEST_CASE STREQUAL "missing_suite")
        set(expected_code 1)
        set(expected_text "Missing test executable")
    else()
        foreach(suite axon_test_runtime axon_test_interp)
            file(COPY "${bin_dir}/${suite}${suffix}" DESTINATION "${work}")
        endforeach()
        if(TEST_CASE STREQUAL "failing_suite")
            file(REMOVE "${work}/axon_test_runtime${suffix}")
            file(COPY "${EXIT_EXE}" DESTINATION "${work}")
            get_filename_component(exit_name "${EXIT_EXE}" NAME)
            file(RENAME "${work}/${exit_name}" "${work}/axon_test_runtime${suffix}")
            set(expected_code 7)
            set(expected_text "exited with 7")
        else()
            set(expected_text "Running axon_test_interp")
        endif()
    endif()
elseif(TEST_CASE STREQUAL "smoke")
    # Cwd differs from program location; the example imports bare and nested paths.
    set(args run "${VALIDATION_DIR}/main.axon")
    set(expected_text "PASS imports")
elseif(TEST_CASE STREQUAL "flows")
    get_filename_component(example_root "${VALIDATION_DIR}" DIRECTORY)
    set(args run "${example_root}/flows.axon")
    set(expected_text "PASS flows")
elseif(TEST_CASE STREQUAL "import_lex_error")
    file(WRITE "${work}/helper.axon" "func value() { return 77 }\n@\n")
    file(WRITE "${work}/main.axon" "import \"./helper.axon\"\nmain { print(value()) }")
    set(expected_code 1)
    set(expected_text "import: lex error")
elseif(TEST_CASE STREQUAL "import_parse_error")
    file(WRITE "${work}/helper.axon" "unexpected_identifier\n")
    file(WRITE "${work}/main.axon" "import \"./helper.axon\"\nmain { print(77) }")
    set(expected_code 1)
    set(expected_text "import: parse error")
elseif(TEST_CASE STREQUAL "missing_import")
    file(WRITE "${work}/main.axon" "import \"./missing.axon\"\nmain { print(77) }")
    set(expected_code 1)
    set(expected_text "import: file not found")
elseif(TEST_CASE STREQUAL "private_import")
    file(WRITE "${work}/helper.axon" "func _private() { return 77 }\nfunc public_value() { return _private() }")
    file(WRITE "${work}/main.axon" "import \"helper.axon\"\nmain { print(public_value()) print(_private()) }")
    set(expected_code 1)
    set(expected_text "undefined variable '_private'")
elseif(TEST_CASE STREQUAL "nested_import")
    file(MAKE_DIRECTORY "${work}/lib/sub")
    file(WRITE "${work}/lib/value.axon" "func value() { return 42 }")
    file(WRITE "${work}/lib/sub/wrapper.axon" "import \"../value.axon\"\nfunc wrap() { return value() }")
    file(WRITE "${work}/main.axon" "import \"./lib/sub/wrapper.axon\"\nmain { if wrap() != 42 { raise \"bad nested import\" } print(\"PASS\") }")
elseif(TEST_CASE STREQUAL "duplicate_import")
    file(MAKE_DIRECTORY "${work}/lib")
    file(WRITE "${work}/helper.axon" "func value() { return 42 }")
    file(WRITE "${work}/main.axon" "import \"./helper.axon\"\nimport \"./lib/../helper.axon\"\nmain { if value() != 42 { raise \"bad duplicate import\" } print(\"PASS\") }")
elseif(TEST_CASE STREQUAL "circular_import")
    file(MAKE_DIRECTORY "${work}/lib")
    file(WRITE "${work}/helper.axon" "import \"./lib/../main.axon\"\nfunc value() { return 42 }")
    file(WRITE "${work}/main.axon" "import \"./helper.axon\"\nmain { if value() != 42 { raise \"bad cycle\" } print(\"PASS\") }")
elseif(TEST_CASE STREQUAL "unsupported_hash")
    file(WRITE "${work}/main.axon" "main { print(hash->sha1(\"abc\")) }")
    set(expected_code 1)
    set(expected_text "is not implemented")
elseif(TEST_CASE STREQUAL "uncaught_raise")
    file(WRITE "${work}/main.axon" "main { raise \"top-level failure\" }")
    set(expected_code 1)
    set(expected_text "uncaught raise: top-level failure")
elseif(TEST_CASE STREQUAL "function_raise")
    file(WRITE "${work}/main.axon" "func fail() { raise \"function failure\" } main { fail() }")
    set(expected_code 1)
    set(expected_text "uncaught raise: function failure")
elseif(TEST_CASE STREQUAL "caught_raise")
    file(WRITE "${work}/main.axon" "main { try { raise \"handled\" } catch err { print(\"PASS \" + err) } }")
    set(expected_text "PASS handled")
elseif(TEST_CASE STREQUAL "division_zero")
    file(WRITE "${work}/main.axon" "main { value = 1 / 0 }")
    set(expected_code 1)
    set(expected_text "uncaught raise: DivisionByZero")
elseif(TEST_CASE STREQUAL "task_contract")
    set(args run "${VALIDATION_DIR}/tasks.axon")
    set(expected_text "PASS tasks")
elseif(TEST_CASE STREQUAL "parallel")
    set(args run "${VALIDATION_DIR}/parallel.axon")
    set(expected_text "PASS parallel")
elseif(TEST_CASE STREQUAL "parallel_failure")
    file(WRITE "${work}/main.axon" "func fail() { raise \"parallel failure\" } main { parallel { a=1 b=fail() } }")
    set(expected_code 1)
    set(expected_text "uncaught raise: parallel failure")
elseif(TEST_CASE STREQUAL "flow_timeout")
    file(WRITE "${work}/main.axon" "flow F { timeout=0.02 debug=false } main { while true {} }")
    set(expected_code 1)
    set(expected_text "TimeoutError: flow")
elseif(TEST_CASE STREQUAL "provider_missing")
    file(WRITE "${work}/main.axon" "agent A { provider missing_provider model fixture task T { prompt=[\"generate\"] } } main { A(1) }")
    set(expected_code 1)
    set(expected_text "ProviderError: provider 'missing_provider' is not registered")
elseif(TEST_CASE STREQUAL "function_arity")
    file(WRITE "${work}/main.axon" "func add(a,b) { return a+b }\nmain { add(1) }")
    set(expected_code 1)
    set(expected_text "ArityError: function 'add' expects 2 argument(s), got 1 at line 2")
elseif(TEST_CASE STREQUAL "imported_function_arity")
    file(WRITE "${work}/helper.axon" "func identity(x) { return x }")
    file(WRITE "${work}/main.axon" "import \"./helper.axon\"\nmain { identity(1,2) }")
    set(expected_code 1)
    set(expected_text "ArityError: function 'identity' expects 1 argument(s), got 2 at line 2")
elseif(TEST_CASE STREQUAL "http_invalid_url")
    file(WRITE "${work}/main.axon" "main { http->get(\"file:///tmp/fixture\") }")
    set(expected_code 1)
    set(expected_text "HttpError: only HTTP and HTTPS URLs are supported")
else()
    message(FATAL_ERROR "Unknown case: ${TEST_CASE}")
endif()
execute_process(COMMAND "${command}" ${args}
    WORKING_DIRECTORY "${work}" RESULT_VARIABLE code
    OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 15)
set(output "${stdout}\n${stderr}")
if(NOT "${code}" STREQUAL "${expected_code}")
    message(FATAL_ERROR "${TEST_CASE}: expected exit ${expected_code}, got ${code}\n${output}")
endif()
string(FIND "${output}" "${expected_text}" found)
if(found LESS 0)
    message(FATAL_ERROR "${TEST_CASE}: missing '${expected_text}'\n${output}")
endif()
message(STATUS "PASS ${TEST_CASE}")
