# Execute the actual Markdown examples; never keep a separate copied fixture.
cmake_minimum_required(VERSION 3.20)
foreach(required AXON_EXE SOURCE_ROOT WORK_ROOT)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
set(total 0)
set(runs 0)
set(checks 0)
foreach(doc README.md docs/LANGUAGE.md docs/MODULES.md)
    file(READ "${SOURCE_ROOT}/${doc}" remaining)
    string(REPLACE "\r\n" "\n" remaining "${remaining}")
    set(index 0)
    while(TRUE)
        string(FIND "${remaining}" "```axon\n" begin)
        if(begin LESS 0)
            break()
        endif()
        string(SUBSTRING "${remaining}" 0 ${begin} prefix)
        string(REGEX MATCH "<!-- axon-check: (run|check) -->[ \t\n]*$" marker "${prefix}")
        if(NOT marker)
            message(FATAL_ERROR "${doc}: every axon fence needs an axon-check run/check marker")
        endif()
        set(mode "${CMAKE_MATCH_1}")
        math(EXPR begin "${begin} + 8")
        string(SUBSTRING "${remaining}" ${begin} -1 remaining)
        string(FIND "${remaining}" "\n```" end)
        if(end LESS 0)
            message(FATAL_ERROR "${doc}: unterminated axon fence")
        endif()
        string(SUBSTRING "${remaining}" 0 ${end} program)
        math(EXPR after "${end} + 4")
        string(SUBSTRING "${remaining}" ${after} -1 remaining)
        math(EXPR index "${index} + 1")
        math(EXPR total "${total} + 1")
        string(REPLACE "/" "_" doc_id "${doc}")
        set(work "${WORK_ROOT}/${doc_id}-${index}")
        file(MAKE_DIRECTORY "${work}")
        file(WRITE "${work}/example.axon" "${program}\n")
        execute_process(COMMAND "${AXON_EXE}" "${mode}" "${work}/example.axon"
            WORKING_DIRECTORY "${work}" TIMEOUT 30
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
        if(NOT "${result}" STREQUAL "0")
            message(FATAL_ERROR "${doc} example ${index} (${mode}) failed: ${result}\n${output}\n${error}")
        endif()
        if(mode STREQUAL "run")
            math(EXPR runs "${runs} + 1")
        else()
            math(EXPR checks "${checks} + 1")
        endif()
    endwhile()
    if(index EQUAL 0)
        message(FATAL_ERROR "${doc}: no checked examples found")
    endif()
endforeach()
message(STATUS "PASS: ${total} Markdown examples (${runs} executed, ${checks} syntax-only)")
