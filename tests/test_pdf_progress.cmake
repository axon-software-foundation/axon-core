# Standalone regression: cmake -DAXON_EXE=./build-validation/axon.exe -P tests/test_pdf_progress.cmake
cmake_minimum_required(VERSION 3.20)
if(NOT DEFINED AXON_EXE)
    message(FATAL_ERROR "Provide -DAXON_EXE=path/to/axon")
endif()
get_filename_component(AXON_EXE "${AXON_EXE}" ABSOLUTE)
if(NOT DEFINED WORK_ROOT)
    set(WORK_ROOT "${CMAKE_CURRENT_BINARY_DIR}/build-pdf-regression")
endif()
get_filename_component(WORK_ROOT "${WORK_ROOT}" ABSOLUTE)
set(passed 0)
foreach(case signed_numbers comments unsupported_token legacy_numbers)
    if(case STREQUAL "signed_numbers")
        set(array "(A) +120 (B) -200 (C)")
        set(expected "AB C")
    elseif(case STREQUAL "comments")
        set(array "(A) % comment (NOT TEXT)\n(B)")
        set(expected "AB")
    elseif(case STREQUAL "unsupported_token")
        set(array "(A) /Ignored (B)")
        set(expected "AB")
    else()
        set(array "(LEGACY) -200 (OK)")
        set(expected "LEGACY OK")
    endif()
    set(work "${WORK_ROOT}/${case} space")
    file(MAKE_DIRECTORY "${work}")
    set(content "BT [${array}] TJ ET")
    string(LENGTH "${content}" length)
    # Synthetic stream fixtures exercise Axon's native scanner, not an external PDF library.
    file(WRITE "${work}/fixture.pdf" "%PDF-1.4\n1 0 obj\n<< /Length ${length} >>\nstream\n${content}\nendstream\nendobj\n%%EOF\n")
    file(WRITE "${work}/main.axon" "flow F { debug=false }\nmain {\n path=\"${work}/fixture.pdf\"\n plain=file->read(path)\n parsed=pdf->parse(path,\"s\")\n alias=pdf->text(path)\n image_mode=pdf->parse(path,\"i\")\n if plain != \"${expected}\" { raise \"file read regression\" }\n if parsed[\"text\"] != \"${expected}\" { raise \"parse regression\" }\n if alias != \"${expected}\" { raise \"text alias regression\" }\n if image_mode[\"text\"] != \"${expected}\" { raise \"image-mode text regression\" }\n print(\"PASS PDF ${case}\")\n}\n")
    execute_process(COMMAND "${AXON_EXE}" run "${work}/main.axon"
        WORKING_DIRECTORY "${work}" TIMEOUT 10
        RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT "${code}" STREQUAL "0")
        message(FATAL_ERROR "${case}: ${code}\n${output}\n${error}")
    endif()
    string(FIND "${output}" "PASS PDF ${case}" marker)
    if(marker LESS 0)
        message(FATAL_ERROR "${case}: missing completion marker\n${output}\n${error}")
    endif()
    math(EXPR passed "${passed}+1")
endforeach()
message(STATUS "PASS: ${passed} PDF progress cases, four entry points each")
