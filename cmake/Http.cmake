# System libcurl on Unix; pinned, minimal static curl + Schannel for Windows portability.
option(AXON_BUNDLED_CURL "Build the pinned minimal static libcurl" ${WIN32})
if(AXON_BUNDLED_CURL)
    include(FetchContent)
    if(POLICY CMP0135)
        cmake_policy(SET CMP0135 NEW)
    endif()
    set(BUILD_CURL_EXE OFF CACHE BOOL "" FORCE)
    set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
    set(BUILD_STATIC_LIBS ON CACHE BOOL "" FORCE)
    set(BUILD_LIBCURL_DOCS OFF CACHE BOOL "" FORCE)
    set(ENABLE_CURL_MANUAL OFF CACHE BOOL "" FORCE)
    set(CURL_BUILD_EVERYTHING OFF CACHE BOOL "" FORCE)
    set(CURL_DISABLE_INSTALL ON CACHE BOOL "" FORCE)
    foreach(feature CURL_ZLIB CURL_BROTLI CURL_ZSTD CURL_USE_LIBPSL USE_LIBIDN2
            CURL_USE_LIBSSH2 CURL_USE_LIBSSH USE_NGHTTP2 USE_NGHTTP3 USE_NGTCP2
            CURL_USE_GSSAPI CURL_USE_GSASL USE_WIN32_IDN USE_APPLE_IDN)
        set(${feature} OFF CACHE BOOL "" FORCE)
    endforeach()
    foreach(protocol DICT FTP GOPHER IMAP LDAP LDAPS MQTT POP3 RTSP SMB SMTP TELNET TFTP)
        set(CURL_DISABLE_${protocol} ON CACHE BOOL "" FORCE)
    endforeach()
    set(ENABLE_THREADED_RESOLVER ON CACHE BOOL "" FORCE)
    if(WIN32)
        set(CURL_USE_SCHANNEL ON CACHE BOOL "" FORCE)
        set(CURL_USE_OPENSSL OFF CACHE BOOL "" FORCE)
        set(CURL_CA_BUNDLE "none" CACHE STRING "" FORCE)
        set(CURL_CA_PATH "none" CACHE STRING "" FORCE)
    else()
        set(CURL_USE_OPENSSL ON CACHE BOOL "" FORCE)
    endif()
    # Do not build upstream's own test suite as part of Axon's default build.
    set(_axon_testing ${BUILD_TESTING})
    set(BUILD_TESTING OFF)
    FetchContent_Declare(axon_curl
        URL https://github.com/curl/curl/releases/download/curl-8_23_0/curl-8.23.0.tar.xz
        URL_HASH SHA256=8dadd7d2536a314f982ad05a651b713f426bf7d02cc2c76cffb9796f2218e6c5)
    FetchContent_MakeAvailable(axon_curl)
    set(BUILD_TESTING ${_axon_testing})
    set(AXON_CURL_TARGET libcurl_static)
else()
    find_package(CURL 7.68 REQUIRED)
    set(AXON_CURL_TARGET CURL::libcurl)
endif()
add_library(axon_http STATIC runtime/src/http_client.cpp)
target_link_libraries(axon_http PUBLIC axon_core ${AXON_CURL_TARGET})
if(AXON_BUNDLED_CURL)
    target_compile_definitions(axon_http PRIVATE CURL_STATICLIB)
endif()
