cmake_minimum_required(VERSION 3.20)
set(version "@AXON_VERSION@")
set(source [==[@CMAKE_CURRENT_SOURCE_DIR@]==])
set(build [==[@CMAKE_CURRENT_BINARY_DIR@]==])
set(dist [==[@AXON_DIST_DIR@]==])
if(NOT AXON_CONFIG STREQUAL "Release")
    message(FATAL_ERROR "Portable packages require Release; use scripts/package.sh")
endif()
if("@CMAKE_CROSSCOMPILING@")
    message(FATAL_ERROR "Native packaging only: the extracted binaries must execute on this host")
endif()
if("@CMAKE_SYSTEM_NAME@" STREQUAL "Windows")
    if(NOT "@MINGW@" OR NOT "@AXON_STATIC_RUNTIME@" OR NOT "@CMAKE_SIZEOF_VOID_P@" STREQUAL "8"
       OR NOT "@CMAKE_SYSTEM_PROCESSOR@" MATCHES "^(AMD64|amd64|x86_64|X86_64)$")
        message(FATAL_ERROR "Windows portable currently requires native x64 MinGW GCC + AXON_STATIC_RUNTIME=ON")
    endif()
    set(platform windows-x64)
    set(extension zip)
    set(format zip)
elseif("@CMAKE_SYSTEM_NAME@" STREQUAL "Linux")
    # Native validation archive only; shared system libraries are not bundled.
    set(platform "linux-@CMAKE_SYSTEM_PROCESSOR@")
    set(extension tar.gz)
    set(format gnutar)
else()
    message(FATAL_ERROR "Packaging for this platform is pending validation (including macOS)")
endif()

# The only recursive removals are fixed scratch children of this build directory.
set(stage "${build}/portable-stage")
set(check "${build}/portable-check with spaces")
file(REMOVE_RECURSE "${stage}" "${check}")
set(name "axon-v${version}-${platform}")
set(root "${stage}/${name}")
file(MAKE_DIRECTORY "${root}/bin" "${root}/docs" "${check}/unrelated working directory")
file(COPY "${AXON_CLI}" "${AXON_RUNTIME_TEST}" "${AXON_INTERP_TEST}" DESTINATION "${root}/bin")
get_filename_component(cli_name "${AXON_CLI}" NAME)
file(COPY "${source}/LICENSE" "${source}/VERSION" "${source}/THIRD_PARTY_NOTICES.md" DESTINATION "${root}")
file(COPY "${source}/licenses" DESTINATION "${root}")
file(COPY "${source}/docs/PORTABLE.md" "${source}/docs/RELEASE_NOTES.md"
    "${source}/docs/ROADMAP.md" "${source}/docs/HTTP_STATUS.md"
    "${source}/docs/LANGUAGE.md" "${source}/docs/MODULES.md"
    "${source}/docs/EXECUTION_CONTROL.md" "${source}/docs/PARALLEL.md" DESTINATION "${root}/docs")
file(COPY "${source}/examples/validation" DESTINATION "${root}/examples")
file(COPY "${source}/examples/flows.axon" DESTINATION "${root}/examples")

file(WRITE "${root}/BUILD_INFO.txt"
    "Axon ${version}\nPlatform: ${platform}\nConfiguration: ${AXON_CONFIG}\nCompiler: @CMAKE_CXX_COMPILER_ID@ @CMAKE_CXX_COMPILER_VERSION@\nCMake: @CMAKE_VERSION@\nStatic MinGW runtime: @AXON_STATIC_RUNTIME@\nLocal candidate: clean-machine acceptance and release tag are required before publication.\n")

# Record provenance when building from a checkout. Source ZIPs without .git
# remain buildable, but are explicitly marked rather than assigned a fake SHA.
set(source_commit "unavailable (not a Git checkout)")
set(source_state "unavailable")
find_program(git_executable NAMES git)
if(git_executable AND EXISTS "${source}/.git")
    execute_process(COMMAND "${git_executable}" -C "${source}" rev-parse HEAD
        RESULT_VARIABLE git_result OUTPUT_VARIABLE git_commit
        OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if("${git_result}" STREQUAL "0" AND git_commit MATCHES "^[0-9a-f]+$")
        set(source_commit "${git_commit}")
        execute_process(COMMAND "${git_executable}" -C "${source}" status --porcelain --untracked-files=normal
            RESULT_VARIABLE git_status_result OUTPUT_VARIABLE git_status ERROR_QUIET)
        if("${git_status_result}" STREQUAL "0")
            if(git_status STREQUAL "")
                set(source_state "clean")
            else()
                set(source_state "dirty")
            endif()
        endif()
    endif()
endif()
file(APPEND "${root}/BUILD_INFO.txt" "Source commit: ${source_commit}\nSource state: ${source_state}\n")

if(platform STREQUAL "windows-x64")
    # Copy notices from the toolchain actually used, not from an unrelated release.
    get_filename_component(compiler_bin [==[@CMAKE_CXX_COMPILER@]==] DIRECTORY)
    get_filename_component(toolchain "${compiler_bin}" DIRECTORY)
    foreach(component winpthreads crt)
        if(NOT EXISTS "${toolchain}/share/licenses/${component}/COPYING")
            message(FATAL_ERROR "Missing ${component} license in ${toolchain}/share/licenses. Install the MSYS2 UCRT64 toolchain including winpthreads and CRT.")
        endif()
        file(COPY "${toolchain}/share/licenses/${component}" DESTINATION "${root}/licenses/toolchain")
    endforeach()
    # Inspect PE imports; static GCC/libstdc++/winpthreads must leave OS imports only.
    # Fail closed on a new dependency instead of creating a broken portable ZIP.
    foreach(exe "${AXON_CLI}" "${AXON_RUNTIME_TEST}" "${AXON_INTERP_TEST}")
        execute_process(COMMAND [==[@CMAKE_OBJDUMP@]==] -p "${exe}"
            RESULT_VARIABLE result OUTPUT_VARIABLE imports ERROR_VARIABLE error)
        if(NOT "${result}" STREQUAL "0")
            message(FATAL_ERROR "Cannot inspect PE dependencies: ${exe}\n${error}")
        endif()
        string(TOLOWER "${imports}" imports)
        string(REGEX MATCHALL "dll name: [^\r\n]+" dlls "${imports}")
        if(NOT dlls)
            message(FATAL_ERROR "No PE dependency records found for ${exe}")
        endif()
        get_filename_component(exe_name "${exe}" NAME)
        file(APPEND "${root}/BUILD_INFO.txt" "\n${exe_name} imports:\n")
        foreach(dll IN LISTS dlls)
            string(REGEX REPLACE "^dll name: " "" dll "${dll}")
            string(STRIP "${dll}" dll)
            if(NOT dll MATCHES "^(kernel32|kernelbase|advapi32|ws2_32|msvcrt|ucrtbase|user32|shell32|ole32|oleaut32|bcrypt|ntdll|secur32|crypt32|iphlpapi|userenv|version)\\.dll$"
               AND NOT dll MATCHES "^(api-ms-win-|ext-ms-win-)[a-z0-9.-]+\\.dll$")
                message(FATAL_ERROR "Non-system DLL ${dll} required by ${exe_name}; no ZIP was generated. Check static runtime linkage.")
            endif()
            file(APPEND "${root}/BUILD_INFO.txt" "  ${dll}\n")
        endforeach()
    endforeach()
endif()

# Content hashes allow checking individual extracted files, including binaries.
file(GLOB_RECURSE payload LIST_DIRECTORIES false RELATIVE "${root}" "${root}/*")
list(SORT payload)
set(manifest "")
foreach(path IN LISTS payload)
    file(SHA256 "${root}/${path}" hash)
    string(APPEND manifest "${hash}  ${path}\n")
endforeach()

# GNU sha256sum treats a CR as part of the filename. Force LF on every host.
file(CONFIGURE OUTPUT "${root}/MANIFEST.sha256" CONTENT "${manifest}"
    @ONLY NEWLINE_STYLE LF)

# Archive, extract, then run from a separate working directory with spaces.
set(candidate "${build}/${name}.${extension}.candidate")
if(format STREQUAL "zip")
    execute_process(COMMAND "@CMAKE_COMMAND@" -E tar cf "${candidate}" --format=zip "${name}"
        WORKING_DIRECTORY "${stage}" RESULT_VARIABLE result)
else()
    execute_process(COMMAND "@CMAKE_COMMAND@" -E tar czf "${candidate}" "${name}"
        WORKING_DIRECTORY "${stage}" RESULT_VARIABLE result)
endif()
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Archive creation failed: ${result}")
endif()
file(ARCHIVE_EXTRACT INPUT "${candidate}" DESTINATION "${check}")
set(installed "${check}/${name}")
foreach(path IN LISTS payload)
    file(SHA256 "${root}/${path}" expected_hash)
    file(SHA256 "${installed}/${path}" extracted_hash)
    if(NOT extracted_hash STREQUAL expected_hash)
        message(FATAL_ERROR "Extracted file checksum mismatch: ${path}")
    endif()
endforeach()
set(executable "${installed}/bin/${cli_name}")
set(command_prefix)
if(platform STREQUAL "windows-x64")
    # Keep Windows runtime environment, but remove Git/MSYS2/compiler from PATH.
    set(command_prefix "@CMAKE_COMMAND@" -E env "PATH=$ENV{SystemRoot}/System32\;$ENV{SystemRoot}")
endif()
function(smoke expected)
    execute_process(COMMAND ${command_prefix} "${executable}" ${ARGN}
        WORKING_DIRECTORY "${check}/unrelated working directory"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
    if(NOT "${result}" STREQUAL "${expected}")
        message(FATAL_ERROR "Extracted package failed: ${ARGN}\nexit=${result}\n${output}\n${error}")
    endif()
    set(smoke_output "${output}\n${error}" PARENT_SCOPE)
endfunction()
smoke(0 version)
string(FIND "${smoke_output}" "${version}" version_pos)
if(version_pos LESS 0)
    message(FATAL_ERROR "Extracted CLI version does not match VERSION")
endif()
smoke(0 test)
foreach(sample functions main tasks delays)
    smoke(0 run "${installed}/examples/validation/${sample}.axon")
endforeach()
smoke(0 run "${installed}/examples/flows.axon")
file(WRITE "${check}/uncaught.axon" "main { raise \"portable expected error\" }\n")
smoke(1 run "${check}/uncaught.axon")
if(NOT smoke_output MATCHES "uncaught raise: portable expected error")
    message(FATAL_ERROR "Expected controlled raise diagnostic was not emitted")
endif()

file(MAKE_DIRECTORY "${dist}")
file(SHA256 "${candidate}" archive_hash)
configure_file("${candidate}" "${dist}/${name}.${extension}" COPYONLY)
file(CONFIGURE OUTPUT "${dist}/${name}.${extension}.sha256"
    CONTENT "${archive_hash}  ${name}.${extension}\n" @ONLY NEWLINE_STYLE LF)
message(STATUS "PASS: extracted portable package and self-tests")
message(STATUS "Archive: ${dist}/${name}.${extension}")
message(STATUS "SHA256:  ${archive_hash}")
